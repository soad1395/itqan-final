 <!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>منصة الإتقان الذكي</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
body{margin:0;font-family:Arial;background:#eef3ef}
.dark{background:#1e1e1e;color:#fff}

.header{
background:#2f6f44;
color:#fff;
padding:20px;
text-align:center;
}

.menu{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:8px;
}

.btn{
background:#ffffff22;
color:#fff;
padding:8px 12px;
border-radius:20px;
cursor:pointer;
font-size:13px;
}

.container{padding:15px}

.section{display:none}
.active{display:block}

.box{
background:#fff;
padding:15px;
border-radius:15px;
margin-bottom:10px;
}

.dark .box{background:#2a2a2a}

.grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px;
}

.card{
background:#e9eeec;
padding:15px;
border-radius:12px;
text-align:center;
}

input,textarea{
width:100%;
padding:8px;
margin-top:5px;
}

button{
background:#2f6f44;
color:#fff;
border:none;
padding:8px;
margin-top:5px;
border-radius:10px;
}

</style>
</head>

<body>

<div class="header">
<h2>منصة الإتقان الذكي ✔</h2>

<div class="menu">
<div class="btn" onclick="go('home')">الرئيسية</div>
<div class="btn" onclick="go('classes')">الفصول/الطالبات</div>
<div class="btn" onclick="go('grades')">الدرجات</div>
<div class="btn" onclick="go('report')">التقارير</div>
<div class="btn" onclick="go('parents')">أولياء الأمور</div>
<div class="btn" onclick="go('games')">الألعاب</div>
<div class="btn" onclick="go('sources')">المصادر</div>
<div class="btn" onclick="toggleMode()">🌙</div>
</div>
</div>

<div class="container">

<!-- الرئيسية -->
<div id="home" class="section active">
<div class="box">
✔ حفظ تلقائي
<p>أضيفي فصل → طالبات → درجات → تقرير</p>
</div>

<div class="grid">
<div class="card" id="c_students">0<br>عدد الطالبات</div>
<div class="card" id="c_classes">0<br>عدد الفصول</div>
<div class="card" id="c_parents">0<br>أولياء الأمور</div>
<div class="card">تحليل جاهز ✔</div>
</div>
</div>

<!-- الفصول -->
<div id="classes" class="section">
<div class="box">
<h3>الفصول</h3>
<input id="className">
<button onclick="addClass()">إضافة فصل</button>
<div id="classList"></div>
</div>

<div class="box">
<h3>الطالبات (جماعي)</h3>
<textarea id="studentsText"></textarea>
<button onclick="addStudents()">إضافة</button>
<div id="studentsList"></div>
</div>
</div>

<!-- الدرجات -->
<div id="grades" class="section">
<div class="box">

<select id="studentSelect"></select>

<label>اختبار (60)</label>
<input id="exam" type="number">

<label>مهمات (40)</label>
<input id="tasks" type="number">

<button onclick="saveGrade()">حفظ</button>

</div>
</div>

<!-- التقارير -->
<div id="report" class="section">
<div class="box">
<div id="analysis"></div>
<canvas id="chart"></canvas>
<button onclick="window.print()">🖨 طباعة</button>
</div>
</div>

<!-- أولياء الأمور -->
<div id="parents" class="section">
<div class="box">
<input id="parentName" placeholder="اسم ولي الأمر">
<button onclick="addParent()">إضافة</button>
<div id="parentList"></div>
</div>
</div>

<!-- الألعاب -->
<div id="games" class="section">
<div class="box">
<a href="https://wordwall.net" target="_blank">Wordwall</a><br>
<a href="https://kahoot.com" target="_blank">Kahoot</a>
</div>
</div>

<!-- المصادر -->
<div id="sources" class="section">
<div class="box">
<a href="https://www.ien.edu.sa" target="_blank">عين</a><br>
<a href="https://noor.moe.gov.sa" target="_blank">نور</a>
</div>
</div>

</div>

<script>

function go(x){
document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
document.getElementById(x).classList.add('active');
}

function toggleMode(){
document.body.classList.toggle("dark");
}

let classes=[];
let students=[];
let parents=[];
let grades=[];

function addClass(){
classes.push(className.value);
render();
}

function addStudents(){
students = students.concat(
document.getElementById("studentsText").value.split("\n")
);
render();
}

function addParent(){
parents.push(parentName.value);
render();
}

function saveGrade(){
let exam=parseFloat(document.getElementById("exam").value)||0;
let tasks=parseFloat(document.getElementById("tasks").value)||0;
let total=exam+tasks;
grades.push(total);
updateReport();
}

function updateReport(){
let avg=grades.reduce((a,b)=>a+b,0)/(grades.length||1);

let level="";
if(avg>=85) level="فوق المتوسط";
else if(avg>=60) level="ضمن المتوسط";
else level="دون المتوسط";

document.getElementById("analysis").innerHTML=
"المتوسط: "+avg.toFixed(1)+"<br>"+level;

if(window.chart) chart.destroy();

chart=new Chart(document.getElementById("chart"),{
type:'bar',
data:{labels:["المتوسط"],datasets:[{data:[avg]}]}
});
}

function render(){

document.getElementById("classList").innerHTML=classes.join("<br>");
document.getElementById("studentsList").innerHTML=students.join("<br>");
document.getElementById("parentList").innerHTML=parents.join("<br>");

document.getElementById("studentSelect").innerHTML=
students.map(s=>"<option>"+s+"</option>").join("");

document.getElementById("c_students").innerHTML=students.length+"<br>عدد الطالبات";
document.getElementById("c_classes").innerHTML=classes.length+"<br>عدد الفصول";
document.getElementById("c_parents").innerHTML=parents.length+"<br>أولياء الأمور";
}

</script>

</body>
</html>
